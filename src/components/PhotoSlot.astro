---
/* Placeholder for a photo Lorenzo hasn't uploaded yet. Same dimensions as a
   real photo so the layout is finished before the images arrive. */
const { label = 'Photo coming soon' } = Astro.props;
---

<div class="photo-slot" role="img" aria-label={label}>
  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7a1 1 0 0 0 .83-.45l.94-1.4A1 1 0 0 1 9.8 3.7h4.4a1 1 0 0 1 .83.45l.94 1.4a1 1 0 0 0 .83.45h1.7A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-8Z"
      stroke="currentColor"
      stroke-width="1.6"></path>
    <circle cx="12" cy="12.2" r="3.4" stroke="currentColor" stroke-width="1.6"></circle>
  </svg>
</div>
